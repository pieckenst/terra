# Bot process env (loaded from this file or `.env.local` in the same directory).
# `core.ts` also checks the project root and `src/` under cwd.

token=

# MUST match dashboard `NEXTAUTH_SECRET` exactly (signed JWT for REST + /ws).
NEXTAUTH_SECRET=

# Same value as dashboard `NEXT_PUBLIC_BOT_API_URL` (keep deployments in sync).
NEXT_PUBLIC_BOT_API_URL=http://localhost:3001

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DATABASE_URL=file:./dev.db
