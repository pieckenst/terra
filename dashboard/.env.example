# Copy to `.env.local` in this folder (Next.js loads it automatically for `next dev` / `next build`).
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Base URL of the bot Fastify API (HTTP + WebSocket). Default bot port is 3001.
NEXT_PUBLIC_BOT_API_URL=http://localhost:3001

# Example for SQLite (adjust path to your setup)
# DATABASE_URL="file:../src/prisma/dev.db"
